{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Web Pentest Evidence Links",
  "type": "object",
  "required": ["schemaVersion", "findingId", "items"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "findingId": { "type": "string", "pattern": "^WEB-[0-9]{2,3}-[0-9]{3}$" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidenceId", "scopeType", "scopeId", "caption", "placement", "order"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^EVD-[0-9]{3}$" },
          "scopeType": { "enum": ["finding", "technical", "procedure", "retest"] },
          "scopeId": { "type": "string" },
          "caption": { "type": "string" },
          "placement": { "enum": ["inline", "appendix", "attachment"] },
          "order": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
