{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Web Pentest Evidence Manifest",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "file", "title", "includeInReport", "containsSensitiveData"],
        "properties": {
          "id": { "type": "string", "pattern": "^EVD-[0-9]{3}$" },
          "type": { "type": "string" },
          "file": { "type": "string" },
          "title": { "type": "string" },
          "caption": { "type": "string" },
          "order": { "type": "integer", "minimum": 0 },
          "includeInReport": { "type": "boolean" },
          "containsSensitiveData": { "type": "boolean" },
          "addedAt": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
