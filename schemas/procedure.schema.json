{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Web Pentest Reproduction Procedure",
  "type": "object",
  "required": ["schemaVersion", "findingId", "preconditions", "nextStepNumber", "steps", "updatedAt"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "findingId": { "type": "string", "pattern": "^WEB-[0-9]{2,3}-[0-9]{3}$" },
    "preconditions": { "type": "string" },
    "nextStepNumber": { "type": "integer", "minimum": 1 },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "title", "action", "expectedResult", "observedResult", "evidence", "includeInReport"],
        "properties": {
          "id": { "type": "string", "pattern": "^STEP-[0-9]{3}$" },
          "order": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "expectedResult": { "type": "string" },
          "observedResult": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "pattern": "^EVD-[0-9]{3}$" },
            "uniqueItems": true
          },
          "includeInReport": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": true
}
