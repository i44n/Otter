{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Web Pentest Finding Retests",
  "type": "object",
  "required": ["schemaVersion", "findingId", "nextRetestNumber", "items", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "findingId": { "type": "string", "pattern": "^WEB-[0-9]{2,3}-[0-9]{3}$" },
    "nextRetestNumber": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "testedAt", "tester", "result", "remediationSummary", "verificationDetails", "notes", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "pattern": "^RT-[0-9]{3}$" },
          "testedAt": { "type": "string", "format": "date" },
          "tester": { "type": "string" },
          "result": { "enum": ["Pending", "Passed", "Failed", "Partial"] },
          "remediationSummary": { "type": "string" },
          "verificationDetails": { "type": "string" },
          "notes": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "updatedAt": { "type": "string" }
  },
  "additionalProperties": false
}
