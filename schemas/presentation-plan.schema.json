{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Otter Presentation Render Plan",
  "type": "object",
  "required": ["formatVersion", "templateHash", "reportIrHash", "profileHash", "pages"],
  "properties": {
    "formatVersion": { "const": 2 },
    "templateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reportIrHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profileHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": {
      "type": "object",
      "required": ["mode", "targetIds"],
      "properties": {
        "mode": { "enum": ["all-targets", "selected-targets"] },
        "targetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "layoutId", "values", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "semanticKey": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "layoutId": { "type": "string", "minLength": 1 },
          "included": { "type": "boolean", "default": true },
          "values": { "type": "object" },
          "evidence": { "type": "array", "items": { "type": "object" } },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind", "values", "evidence"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "minLength": 1 },
                "values": { "type": "object" },
                "evidence": { "type": "array", "items": { "type": "object" } }
              },
              "additionalProperties": true
            }
          },
          "overrides": { "type": "object" },
          "selection": {
            "type": "object",
            "properties": {
              "familyId": { "type": "string" },
              "variantKind": { "enum": ["primary", "continuation", "static"] },
              "textDensity": { "enum": ["short", "regular", "long"] },
              "evidenceCapacity": { "type": "integer", "minimum": 0 },
              "evidenceCount": { "type": "integer", "minimum": 0 },
              "manual": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": { "type": "array", "items": { "type": "object" } },
    "attachments": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
